generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  nome         String     @db.VarChar(67)
  sobrenome    String     @db.VarChar(67)
  email        String     @unique @db.VarChar(255)
  senha        String     @db.VarChar(67)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  carrinho     CartItem[]
  pedidos      Order[]

  @@map("users")
}

model Hotel {
  id           Int        @id @default(autoincrement())
  nome         String     @db.VarChar(120)
  endereco     String     @db.VarChar(200)
  descricao    String     @db.Text
  estrelas     Int
  preco        Decimal    @db.Decimal(10, 2)
  fotoUrl      String?    @db.VarChar(500)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  carrinho     CartItem[]

  @@map("hotels")
}

model CartItem {
  id          Int       @id @default(autoincrement())
  userId      Int
  hotelId     Int
  diarias     Int       @default(1)
  dataEntrada DateTime? @db.Date
  criadoEm    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int
  formaPagamento String      @db.VarChar(20)
  parcelas       Int         @default(1)
  subtotal       Decimal     @db.Decimal(10, 2)
  desconto       Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  criadoEm       DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens          OrderItem[]

  @@map("orders")
}

model OrderItem {
  id            Int       @id @default(autoincrement())
  orderId       Int
  hotelId       Int
  nomeHotel     String    @db.VarChar(120)
  precoUnitario Decimal   @db.Decimal(10, 2)
  diarias       Int
  dataEntrada   DateTime? @db.Date
  subtotal      Decimal   @db.Decimal(10, 2)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
